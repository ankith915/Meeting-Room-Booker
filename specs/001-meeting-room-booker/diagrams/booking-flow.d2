# Booking Request Flow — every branch, including all nine refusals
# Render: d2 --layout elk --theme 4 booking-flow.d2 out/booking-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
    pad: 40
  }
}

title: |md
  # createBooking() — every path a request can take
  _Constitution V: no silent failures. Every refusal is typed and specific._
| {near: top-center; style.font-size: 28}

direction: down

classes: {
  step: {
    style: {fill: "#EEF2FF"; stroke: "#4F46E5"; stroke-width: 2; border-radius: 10; font-color: "#312E81"}
  }
  gate: {
    shape: diamond
    style: {fill: "#FEF9C3"; stroke: "#CA8A04"; stroke-width: 2; font-color: "#713F12"}
  }
  reject: {
    style: {fill: "#FEE2E2"; stroke: "#DC2626"; stroke-width: 2; border-radius: 10; font-color: "#7F1D1D"}
  }
  win: {
    style: {fill: "#DCFCE7"; stroke: "#059669"; stroke-width: 3; border-radius: 10; font-color: "#064E3B"; bold: true}
  }
  db: {
    style: {fill: "#FEE2E2"; stroke: "#DC2626"; stroke-width: 3; border-radius: 10; font-color: "#7F1D1D"; bold: true}
  }
}

start: User submits booking form {class: step; style.bold: true}

shape_ok: Input shape valid? {class: gate}
e_title: "INVALID_TITLE\nEC-011" {class: reject}
e_range: "INVALID_RANGE\nends_at ≤ starts_at — EC-006" {class: reject}

room_ok: Room exists and is active? {class: gate}
e_notfound: "ROOM_NOT_FOUND\nEC-008" {class: reject}
e_inactive: "ROOM_INACTIVE\nEC-008" {class: reject}

time_ok: Time rules satisfied? {class: gate}
e_past: "PAST_BOOKING\nstart is behind now — EC-007" {class: reject}
e_hours: "OUTSIDE_BUSINESS_HOURS\nnames the real window — EC-009, EC-012" {class: reject}
e_dur: "DURATION_EXCEEDED\nnames the maximum — EC-010" {class: reject}

insert: "INSERT INTO bookings\n(status = 'confirmed')" {class: step; style.bold: true}

excl: |md
  ### bookings_no_overlap
  `EXCLUDE USING GIST (room_id WITH =,`
  `tstzrange(starts_at, ends_at, '[)') WITH &&)`
  `WHERE status = 'confirmed'`

  **Evaluated inside the write, under an index lock**
| {class: db}

ok: "201 CREATED\nbooking confirmed and immediately visible" {class: win}

e_taken: "409 SLOT_TAKEN\nEC-001, EC-002" {class: reject; style.stroke-width: 3}
enrich: "Fetch conflicting booking\n+ compute alternatives" {class: step}
resp: "Refusal carries:\n• who holds the slot\n• its title and time\n• other free rooms\n• nearest free ranges\nFR-009, FR-010" {class: reject}

start -> shape_ok
shape_ok -> e_title: blank / too long {style.stroke: "#DC2626"}
shape_ok -> e_range: non-positive duration {style.stroke: "#DC2626"}
shape_ok -> room_ok: valid {style.stroke: "#059669"; style.bold: true}

room_ok -> e_notfound: unknown id {style.stroke: "#DC2626"}
room_ok -> e_inactive: "is_active = false" {style.stroke: "#DC2626"}
room_ok -> time_ok: active {style.stroke: "#059669"; style.bold: true}

time_ok -> e_past: start < now {style.stroke: "#DC2626"}
time_ok -> e_hours: outside opens_at..closes_at {style.stroke: "#DC2626"}
time_ok -> e_dur: "> 8 hours" {style.stroke: "#DC2626"}
time_ok -> insert: all limits satisfied {style.stroke: "#059669"; style.bold: true}

insert -> excl: checked here {style.stroke-width: 3; style.stroke: "#DC2626"; style.bold: true}
excl -> ok: no overlapping confirmed row {style.stroke: "#059669"; style.stroke-width: 3; style.bold: true}
excl -> e_taken: "SQLSTATE 23P01" {style.stroke: "#DC2626"; style.stroke-width: 3; style.bold: true}
e_taken -> enrich
enrich -> resp

note_ux: |md
  **The checks above the line are UX, not safety.**

  Everything from *Input shape* to *Time rules* exists so the user
  gets fast, specific feedback — and so unavailable rooms can be
  greyed out before anyone clicks.

  Delete all of it and **EC-001 through EC-005 are still impossible**,
  because the constraint is what actually holds the line.

  That is exactly what SC-003 tests.
| {
  near: bottom-center
  style: {fill: "#FFFBEB"; stroke: "#D97706"; stroke-width: 2; border-radius: 8; font-color: "#78350F"}
}
