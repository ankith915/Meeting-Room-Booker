# Domain Model — Meeting Room Booker
# Render: d2 --layout elk --theme 4 domain-model.d2 out/domain-model.svg

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
    pad: 40
  }
}

title: |md
  # Domain Model — Room ⟶ Booking
  _One relationship, carrying one invariant_
| {near: top-center; style.font-size: 28}

rooms: rooms {
  shape: sql_table
  style: {stroke: "#4F46E5"; stroke-width: 3}

  id: uuid {constraint: primary_key}
  name: text NOT NULL
  capacity: integer  CHECK > 0
  location: text NOT NULL
  timezone: text  IANA id
  opens_at: time  local wall-clock
  closes_at: time  CHECK > opens_at
  is_active: boolean  default true
}

bookings: bookings {
  shape: sql_table
  style: {stroke: "#059669"; stroke-width: 3}

  id: uuid {constraint: primary_key}
  room_id: uuid {constraint: foreign_key}
  title: text  CHECK length 1..200
  organiser: text NOT NULL
  starts_at: timestamptz  UTC
  ends_at: timestamptz  CHECK > starts_at
  status: enum  confirmed | cancelled
  created_at: timestamptz  default now()
}

rooms.id <- bookings.room_id: one room has many bookings {
  style: {stroke-width: 3; font-size: 16; bold: true}
}

invariant: |md
  ## The Invariant

  Within a **single room**, the intervals of all
  **confirmed** bookings are mutually **non-overlapping**.

  Bookings in *different* rooms are wholly independent
  and may overlap freely.
| {
  style: {fill: "#FEF3C7"; stroke: "#D97706"; stroke-width: 3; border-radius: 12; font-color: "#78350F"}
}

enforcement: |md
  ### Enforced here — not in application code

  ```sql
  CREATE EXTENSION IF NOT EXISTS btree_gist;

  ALTER TABLE bookings
    ADD CONSTRAINT bookings_no_overlap
    EXCLUDE USING GIST (
      room_id                             WITH =,
      tstzrange(starts_at, ends_at, '[)') WITH &&
    )
    WHERE (status = 'confirmed');
  ```
| {
  style: {fill: "#FEE2E2"; stroke: "#DC2626"; stroke-width: 3; border-radius: 12; font-color: "#7F1D1D"}
}

mapping: |||md
  ### Each qualifier maps to one clause

  | Qualifier | Clause | Edge case |
  |---|---|---|
  | within a single room | `room_id WITH =` | EC-004 |
  | non-overlapping | `tstzrange(...) WITH &&` | EC-002 |
  | half-open `[start, end)` | `'[)'` bound argument | EC-003 |
  | confirmed only | `WHERE status = 'confirmed'` | EC-005 |
  | no check-then-write gap | `EXCLUDE` runs inside the write | **EC-001** |
||| {
  style: {fill: "#F1F5F9"; stroke: "#475569"; stroke-width: 2; border-radius: 12; font-color: "#0F172A"}
}

derived: Derived — never stored {
  style: {fill: "#FEF9C3"; stroke: "#CA8A04"; stroke-width: 2; border-radius: 12; font-color: "#713F12"}

  ov: "overlaps(a, b)  =  a.starts_at < b.ends_at AND a.ends_at > b.starts_at"
  av: "isAvailable(room, range)  —  FR-002"
  ds: "daySchedule(room, date)  —  FR-012, room-local day"
  fg: "freeGaps(room, date)  —  FR-013"
  sa: "suggestAlternatives(range)  —  FR-010"
}

bookings -> invariant: carries {style.stroke-width: 2; style.stroke-dash: 3}
invariant -> enforcement: realised as {style.stroke-width: 3; style.bold: true}
enforcement -> mapping: reads as
bookings -> derived: computed from {style.stroke-dash: 3}

states: Booking status transitions {
  style: {fill: "#F5F3FF"; stroke: "#7C3AED"; stroke-width: 2; border-radius: 12}
  confirmed -> cancelled: "cancel() by organiser, before end"
  confirmed -> confirmed: "cancel by other → NOT_ORGANISER (EC-015)\ncancel after end → ALREADY_ENDED (EC-016)" {style.stroke-dash: 4}
  cancelled -> cancelled: "cancel again → no-op, success (EC-017)" {style.stroke-dash: 4}
}

note: |md
  **No path back from cancelled.**

  Reinstating would have to re-acquire a slot that may since
  have been taken — so it is expressed as a *new* booking,
  through the same guarded insert.
| {
  near: bottom-center
  style: {fill: "#FFFBEB"; stroke: "#D97706"; border-radius: 8; font-color: "#78350F"}
}
