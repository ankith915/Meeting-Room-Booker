# dependencies
node_modules/
.pnp
.pnp.js

# next.js — rooted so they only match at the repo root, not anywhere nested
.next/
/out/
/build/
/dist/
next-env.d.ts

# environment — NEVER commit these
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# testing
coverage/
.vitest/

# vercel
.vercel

# typescript
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# os
.DS_Store
Thumbs.db

# editor
.idea/
*.swp
*.swo

# agent credentials — Spec Kit's init warned that agent folders may hold tokens.
# Skills and commands ARE tracked (they are the harness); local state is not.
.claude/settings.local.json
.claude/.credentials.json

# NOTE: rendered diagrams under specs/**/diagrams/out/ are intentionally TRACKED.
# The build-output rules above are rooted (/out/, /build/, /dist/) so they do not
# match nested directories. Do not un-root them.
